# Copy to .env (make setup does this) and fill in. .env is git-ignored.
# Your OpenAI key, needed only with USE_FAKE_MODEL=0.
OPENAI_API_KEY=
# The model the agent uses. Check current names and prices before a real run.
OPENAI_MODEL=gpt-5.4-mini
# 1 = the rule-based fake model (no key, no API calls, no tokens). 0 = call
# OpenAI, which needs OPENAI_API_KEY and spends tokens. The Worker reads this, so
# restart it after a change. `make worker REAL=1` or `FAKE=1` overrides it for one run.
USE_FAKE_MODEL=1
